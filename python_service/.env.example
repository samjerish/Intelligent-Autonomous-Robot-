# ACVS – EDS Fire Detection & Emergency Service Configuration
FIRE_SERVICE_HOST=0.0.0.0
FIRE_SERVICE_PORT=5005

# In TEST_MODE (default: true), all SMS and Voice calls are simulated and recorded safely without incurring charges or dispatching real emergency crews.
TEST_MODE=true

# Twilio Credentials (Required only when TEST_MODE=false)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+12345678901

# Designated Fire Response Team Phone Number
FIRE_RESPONSE_PHONE=+19876543210

# Detection Settings
FIRE_CONFIDENCE_THRESHOLD=0.60
SMOKE_CONFIDENCE_THRESHOLD=0.50
CONSECUTIVE_FRAMES_REQUIRED=2
DEDUPLICATION_WINDOW_SECONDS=60
